# Secrets for the phone. On the Pi this lives at ~/.config/gpt-phone/env (chmod 600),
# loaded by the systemd unit. For Mac development, copy to .env in the repo root.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Optional overrides (see phone/config.py):
# PHONE_LISTEN_MODEL=gemini-3.5-transcribe-live
# PHONE_TEXT_MODEL=gemini-3.5-flash-lite
# PHONE_TTS_MODEL=eleven_flash_v2_5
# PHONE_BARGE_IN=true
# PHONE_VAD_THRESHOLD=0.5
# PHONE_VAD_SILENCE_MS=500
# PHONE_TURN_GRACE_S=0.8
# PHONE_LOG_LEVEL=INFO
